name: Loan Approval Model Training

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      data_path:
        type: str
        default: loan_approval_preprocessing.csv
      n_estimators:
        type: int
        default: 200
      max_depth:
        type: int
        default: 10
      random_state:
        type: int
        default: 42
    command: >
      python ../modelling.py
        --data_path {data_path}
        --n_estimators {n_estimators}
        --max_depth {max_depth}
        --random_state {random_state}
